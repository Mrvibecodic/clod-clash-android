diff --git a/constant/probehold.go b/constant/probehold.go
new file mode 100644
index 0000000..adef14e
--- /dev/null
+++ b/constant/probehold.go
@@ -0,0 +1,13 @@
+package constant
+
+import "sync/atomic"
+
+var probeHoldUntil atomic.Int64
+
+func SetProbeHoldUntil(nanos int64) {
+	probeHoldUntil.Store(nanos)
+}
+
+func ProbeHolding(nanos int64) bool {
+	return nanos < probeHoldUntil.Load()
+}
