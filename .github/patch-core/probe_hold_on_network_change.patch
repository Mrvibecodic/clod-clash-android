diff --git a/constant/probehold.go b/constant/probehold.go
new file mode 100644
index 00000000..24bb32df
--- /dev/null
+++ b/constant/probehold.go
@@ -0,0 +1,28 @@
+package constant
+
+import "sync/atomic"
+
+const probeFreezeGap = int64(45 * 1e9)
+
+var (
+	probeHoldUntil atomic.Int64
+	probeLastBeat  atomic.Int64
+)
+
+func SetProbeHoldUntil(nanos int64) {
+	probeHoldUntil.Store(nanos)
+}
+
+func ProbeBeat(nanos int64) {
+	probeLastBeat.Store(nanos)
+}
+
+func ProbeHolding(nanos int64) bool {
+	if nanos < probeHoldUntil.Load() {
+		return true
+	}
+
+	beat := probeLastBeat.Load()
+
+	return beat != 0 && nanos-beat > probeFreezeGap
+}
